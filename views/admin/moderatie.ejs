<%- include('../partials/header', { title }) %>

<div class="page-container">
  <div class="page-head">
    <h1>Moderatie</h1>
    <p class="sub">Gestionează avertismentele, mesajele și suspendarea conturilor</p>
  </div>

  <% if (query.warned) { %><div class="alert alert-success">✅ Avertisment trimis.</div><% } %>
  <% if (query.banned) { %><div class="alert alert-success">✅ Contul a fost suspendat.</div><% } %>
  <% if (query.unbanned) { %><div class="alert alert-success">✅ Contul a fost deblocat.</div><% } %>
  <% if (query.messaged) { %><div class="alert alert-success">✅ Mesaj trimis.</div><% } %>
  <% if (query.logdeleted) { %><div class="alert alert-success">✅ Înregistrare ștearsă.</div><% } %>
  <% if (query.error) { %><div class="alert alert-error">⚠ Eroare. Verifică datele.</div><% } %>

  <section class="panel" style="margin-bottom:24px;">
    <h3 style="margin-bottom:12px;font-size:20px;">👥 Toți utilizatorii</h3>
    <% users.forEach(u => { %>
      <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #eee;<%= u.is_banned ? 'background:#fff5f5;' : '' %>;">
        <div style="flex:1;min-width:0;">
          <span style="font-size:16px;font-weight:600;"><%= u.name %></span>
          <% if (u.is_admin) { %><span class="badge" style="background:#7c3aed;color:#fff;font-size:10px;">Admin</span><% } %>
          <% if (u.is_banned) { %><span class="badge" style="background:#e53e3e;color:#fff;font-size:10px;">🚫</span><% } %>
          <div style="font-size:13px;color:#666;margin-top:2px;">
            📱 <%= u.phone %>
            <span class="badge" style="background:<%= u.role === 'producer' ? 'var(--green-dark)' : '#6b7280' %>;color:#fff;font-size:10px;"><%= u.role === 'producer' ? 'P' : 'C' %></span>
            <% if (u.warnings > 0) { %> · ⚠️<%= u.warnings %><% } %>
          </div>
        </div>
        <% if (!u.is_admin) { %>
          <div style="display:flex;gap:6px;flex-shrink:0;">
            <button type="button" class="btn btn-mod btn-warn" onclick="openMsgModal(<%= u.id %>, '<%= u.name.replace(/'/g, "\\'") %>', 'warning')" style="font-size:13px;padding:6px 12px;">💬 Mesaj</button>
            <% if (u.is_banned) { %>
              <form method="POST" action="/admin/moderatie/unban" style="display:inline;">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <button type="submit" class="btn btn-mod btn-unban" style="font-size:13px;padding:6px 12px;">✅ Deblochează</button>
              </form>
            <% } else { %>
              <button type="button" class="btn btn-mod btn-ban" onclick="openMsgModal(<%= u.id %>, '<%= u.name.replace(/'/g, "\\'") %>', 'ban')" style="font-size:13px;padding:6px 12px;">🚫</button>
            <% } %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </section>

  <section class="panel">
    <h3 style="margin-bottom:12px;font-size:20px;">📋 Istoric acțiuni (ultimele 50)</h3>
    <% if (!moderationLog.length) { %>
      <div class="empty-state"><p>Nu există acțiuni de moderatie.</p></div>
    <% } %>
    <% moderationLog.forEach(m => { %>
      <div style="display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);">
        <div style="flex-shrink:0;font-size:24px;"><%= m.type === 'ban' ? '🚫' : '⚠️' %></div>
        <div style="flex:1;">
          <div style="font-size:14px;">
            <strong><%= m.user_name %></strong>
            <% if (m.type === 'ban') { %>
              <span class="badge" style="background:#e53e3e;color:#fff;font-size:11px;">Suspendat</span>
            <% } else { %>
              <span class="badge" style="background:#d97706;color:#fff;font-size:11px;">Avertisment</span>
            <% } %>
          </div>
          <p style="margin:4px 0 0;font-size:14px;color:#444;"><%= m.message %></p>
          <small style="color:#999;">
            trimis de <strong><%= m.admin_name || 'Admin' %></strong> · <%= new Date(m.created_at).toLocaleString('ro-RO') %>
          </small>
        </div>
        <form method="POST" action="/admin/moderatie/delete-log" style="display:inline;" onsubmit="return confirm('Ștergi această înregistrare?');">
          <input type="hidden" name="log_id" value="<%= m.id %>">
          <button type="submit" class="btn btn-sm btn-ghost" style="color:#999;font-size:18px;" title="Șterge">✕</button>
        </form>
      </div>
    <% }) %>
  </section>
</div>

<div id="msgModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;max-width:460px;width:92%;box-shadow:0 8px 32px rgba(0,0,0,0.2);">
    <h3 id="msgModalTitle" style="margin:0 0 4px;">💬 Trimite mesaj</h3>
    <p style="margin:0 0 16px;font-size:14px;color:#666;">Către: <strong id="msgTarget"></strong></p>
    <p id="msgModalDesc" style="margin:0 0 12px;font-size:13px;color:#888;"></p>
    <form method="POST" id="msgForm">
      <input type="hidden" name="user_id" id="msgUserId">
      <input type="hidden" name="action_type" id="msgActionType">
      <label class="pa-field">
        <span id="msgFieldLabel">Mesajul tău</span>
        <textarea name="message" id="msgTextarea" rows="4" required placeholder="Scrie mesajul aici..."></textarea>
      </label>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
        <button type="button" class="btn btn-ghost" onclick="closeMsgModal()" style="font-size:16px;padding:10px 20px;">Anulează</button>
        <button type="submit" id="msgSubmitBtn" class="btn btn-primary" style="font-size:16px;padding:10px 24px;">Trimite</button>
      </div>
    </form>
  </div>
</div>

<style>
.btn-mod {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 18px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 500;
  border: none;
  cursor: pointer;
  white-space: nowrap;
}
.btn-warn { background: #fef3c7; color: #92400e; border: 2px solid #f59e0b; }
.btn-warn:hover { background: #fde68a; }
.btn-ban { background: #fee2e2; color: #991b1b; border: 2px solid #e53e3e; }
.btn-ban:hover { background: #fecaca; }
.btn-unban { background: #d1fae5; color: #065f46; border: 2px solid #10b981; }
.btn-unban:hover { background: #a7f3d0; }
</style>

<script>
function openMsgModal(id, name, type) {
  document.getElementById('msgUserId').value = id;
  document.getElementById('msgTarget').textContent = name;
  document.getElementById('msgActionType').value = type;
  document.getElementById('msgForm').action = type === 'ban' ? '/admin/moderatie/ban' : '/admin/moderatie/warn';
  if (type === 'ban') {
    document.getElementById('msgModalTitle').textContent = '🚫 Blochează contul';
    document.getElementById('msgModalTitle').style.color = '#991b1b';
    document.getElementById('msgModalDesc').textContent = 'Utilizatorul nu se va mai putea autentifica.';
    document.getElementById('msgFieldLabel').textContent = 'Motivul blocării (obligatoriu)';
    document.getElementById('msgTextarea').placeholder = 'Ex: Comportament abuziv, încălcarea regulilor repetat...';
    document.getElementById('msgSubmitBtn').textContent = '🚫 Blochează contul';
    document.getElementById('msgSubmitBtn').style.background = '#e53e3e';
  } else {
    document.getElementById('msgModalTitle').textContent = '💬 Trimite mesaj / Avertisment';
    document.getElementById('msgModalTitle').style.color = '#92400e';
    document.getElementById('msgModalDesc').textContent = 'Mesajul va apărea ca un banner galben când utilizatorul deschide aplicația.';
    document.getElementById('msgFieldLabel').textContent = 'Mesajul pentru utilizator';
    document.getElementById('msgTextarea').placeholder = 'Ex: Te rugăm să respecți regulile comunității...';
    document.getElementById('msgSubmitBtn').textContent = '💬 Trimite mesajul';
    document.getElementById('msgSubmitBtn').style.background = '#d97706';
  }
  document.getElementById('msgTextarea').value = '';
  document.getElementById('msgModal').style.display = 'flex';
}
function closeMsgModal() {
  document.getElementById('msgModal').style.display = 'none';
}
</script>

<%- include('../partials/footer') %>
