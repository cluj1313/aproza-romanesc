<%- include('../partials/header', { title }) %>

<div class="page-container auth-wrap">
  <div class="auth-card">
    <div class="auth-logo">
      <img src="/images/logo.jpeg" alt="Aprozar Românesc">
    </div>
    <h1>Parolă nouă 🎉</h1>
    <p class="auth-sub">Codul a fost verificat. Alege o parolă nouă (cel puțin 6 caractere).</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/recuperare/noua" class="form">
      <input type="hidden" name="userId" value="<%= userId %>">
      <label>
        <span>Parolă nouă *</span>
        <div class="pw-wrap">
          <input type="password" name="password" required minlength="6" placeholder="••••••••" autofocus class="pw-input">
          <button type="button" class="pw-toggle" aria-label="Arată parola" tabindex="-1">
            <svg class="pw-eye-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="pw-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          </button>
        </div>
      </label>
      <label>
        <span>Repetă parola *</span>
        <div class="pw-wrap">
          <input type="password" name="password2" required minlength="6" placeholder="••••••••" class="pw-input">
          <button type="button" class="pw-toggle" aria-label="Arată parola" tabindex="-1">
            <svg class="pw-eye-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="pw-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          </button>
        </div>
      </label>
      <button type="submit" class="btn btn-primary btn-block">Salvează parola</button>
    </form>

    <p class="auth-alt"><a href="/login">Mă întorc la autentificare</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
