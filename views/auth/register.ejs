<%- include('../partials/header', { title }) %>

<div class="page-container auth-wrap">
  <div class="auth-card wide">
    <div class="auth-logo">
      <img src="/images/logo.jpeg" alt="Aprozar Românesc">
    </div>
    <h1>Creează un cont</h1>
    <p class="auth-sub">Ești producător sau client?</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/register" class="form">
      <div class="role-select">
        <label class="role-option">
          <input type="radio" name="role" value="customer" <%= form.role === 'customer' ? 'checked' : '' %> required>
          <span class="role-box">
            <span class="role-emoji">🛒</span>
            <strong>Sunt client</strong>
            <small>Caut și cumpăr produse locale</small>
          </span>
        </label>
        <label class="role-option">
          <input type="radio" name="role" value="producer" <%= form.role === 'producer' ? 'checked' : '' %> required>
          <span class="role-box">
            <span class="role-emoji">🌾</span>
            <strong>Sunt producător</strong>
            <small>Vreau să-mi vând produsele</small>
          </span>
        </label>
      </div>

      <label>
        <span>Nume complet / Numele fermei *</span>
        <input type="text" name="name" required value="<%= form.name %>" placeholder="ex. Ferma Popescu">
      </label>

      <label>
        <span>Număr de telefon *</span>
        <input type="tel" name="phone" required value="<%= form.phone %>" placeholder="07xx xxx xxx">
        <small class="field-hint">Folosești telefonul pentru a te autentifica.</small>
      </label>
      <div class="form-row">
        <label>
          <span>Parolă *</span>
          <div class="pw-wrap">
            <input type="password" name="password" required placeholder="Minim 6 caractere" class="pw-input">
            <button type="button" class="pw-toggle" aria-label="Arată parola" tabindex="-1">
              <svg class="pw-eye-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="pw-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </label>
        <label>
          <span>Confirmă parola *</span>
          <div class="pw-wrap">
            <input type="password" name="password2" required placeholder="Repetă parola" class="pw-input">
            <button type="button" class="pw-toggle" aria-label="Arată parola" tabindex="-1">
              <svg class="pw-eye-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="pw-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </label>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Creează contul</button>
    </form>

    <p class="auth-alt">Ai deja cont? <a href="/login">Autentifică-te</a></p>
  </div>
</div>

<script>
  // formularul e simplu: autentificare cu număr de telefon
</script>

<%- include('../partials/footer') %>
