<%- include('../partials/header', { title }) %>

<div class="page-container">
  <div class="pd-hero">
    <% if (producer.cover_url) { %>
      <img src="<%= producer.cover_url %>" alt="Ferma <%= producer.name %>" class="pd-cover">
    <% } else { %>
      <div class="pd-cover fallback"><span>🌾</span></div>
    <% } %>

    <div class="pd-contact-bar">
      <% if (producer.whatsapp) { %>
        <a href="https://wa.me/<%= producer.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="contact-btn wa" title="Scrie pe WhatsApp">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      <% } %>
      <% if (producer.phone) { %>
        <a href="tel:<%= producer.phone %>" class="contact-btn phone" title="Sună">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Sună
        </a>
      <% } %>
    </div>

    <div class="pd-avatar">
      <% if (producer.avatar_url) { %>
        <img src="<%= producer.avatar_url %>" alt="Avatar">
      <% } else { %>
        <span>👨‍🌾</span>
      <% } %>
    </div>
  </div>

  <div class="pd-head">
    <div class="pd-head-left">
      <h1><%= producer.name %></h1>
      <% if (producer.owner_name) { %><p class="pd-owner">👨‍🌾 <%= producer.owner_name %></p><% } %>
      <p class="pd-loc">📍 <%= producer.county %><%= producer.locality ? ' · ' + producer.locality : '' %>
        <% if (producer.address) { %> · <%= producer.address %><% } %>
      </p>
      <% if (producer.distanceLabel) { %><span class="chip chip-distance">🚗 la <%= producer.distanceLabel %> de tine</span><% } %>
      <div class="rating-badge rating-big">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="#f9a825"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <strong><%= rating.avg %></strong>
        <small>· <%= rating.count %> recenzii</small>
      </div>
    </div>
    <% if (producer.phone) { %>
      <a href="tel:<%= producer.phone %>" class="pd-phone-big"><%= producer.phone %></a>
    <% } %>
  </div>

  <% if (producer.description) { %>
    <div class="pd-desc"><p><%= producer.description %></p></div>
  <% } %>

  <% if (announcements.length) { %>
    <section class="home-section">
      <div class="section-head"><h2>Anunțuri</h2><span class="section-sub">De la <%= producer.name %></span></div>
      <% announcements.forEach(ann => { %>
        <div class="announcement-card ann-<%= ann.type %>">
          <div class="ann-icon">
            <% const icons = { discount:'🏷️', offer:'🎁', free_shipping:'🚚', vacation:'🏖️', other:'📢' } %><%= icons[ann.type] %>
          </div>
          <div>
            <strong><%= ann.title %></strong>
            <% if (ann.percent) { %><span class="ann-percent">-<%= ann.percent %>%</span><% } %>
            <% if (ann.message) { %><p><%= ann.message %></p><% } %>
          </div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <section class="home-section">
    <div class="section-head">
      <h2>Produse disponibile</h2>
      <span class="section-sub"><%= products.length %> produse</span>
    </div>

    <% if (products.length === 0) { %>
      <div class="empty-state">
        <p class="empty-emoji">📦</p>
        <h3>Deocamdată nu sunt produse publicate</h3>
      </div>
    <% } else { %>
      <% categories.forEach(cat => { %>
        <h3 class="category-title"><%= cat %></h3>
        <div class="products-grid">
          <% grouped[cat].forEach(pr => { %><%- include('../partials/product-card', { pr }) %><% }) %>
        </div>
      <% }) %>
    <% } %>
  </section>

  <section class="home-section" id="recenzii">
    <div class="section-head">
      <h2>Recenzii</h2>
      <span class="section-sub"><%= rating.avg %>/5 din <%= rating.count %> recenzii</span>
    </div>

    <% if (canReview) { %>
      <div class="panel review-form">
        <h3>Lasă o recenzie</h3>
        <form method="POST" action="/producator/<%= producer.id %>/review">
          <div class="star-input">
            <% for (let s = 5; s >= 1; s--) { %>
              <label>
                <input type="radio" name="rating" value="<%= s %>" required>
                <span class="star">★</span>
              </label>
            <% } %>
          </div>
          <textarea name="comment" rows="3" placeholder="Cum ți s-a părut? Produse, calitate, amabilitate…" required></textarea>
          <button type="submit" class="btn btn-primary btn-sm">Trimite recenzia</button>
        </form>
      </div>
    <% } else if (!user) { %>
      <div class="panel review-form">
        <p class="sub">Vrei să lași o recenzie? <a href="/login?next=/producator/<%= producer.id %>">Autentifică-te</a> ca client.</p>
      </div>
    <% } %>

    <% if (reviews.length === 0) { %>
      <div class="empty-state small"><p class="empty-emoji">💬</p><p>Nicio recenzie încă. Fii primul!</p></div>
    <% } else { %>
      <div class="reviews-list">
        <% reviews.forEach(r => { %>
          <div class="review-item">
            <div class="review-head">
              <span class="review-avatar"><%= (r.user_name || '?').charAt(0).toUpperCase() %></span>
              <div>
                <strong><%= r.user_name %></strong>
                <span class="review-stars">
                  <% for (let s = 1; s <= 5; s++) { %><span class="star <%= s <= r.rating ? 'on' : '' %>">★</span><% } %>
                </span>
              </div>
            </div>
            <% if (r.comment) { %><p class="review-comment"><%= r.comment %></p><% } %>
            <% if (r.reply) { %>
              <div class="review-reply">
                <strong>👨‍🌾 Răspunsul producătorului:</strong>
                <p><%= r.reply %></p>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<a href="/" class="home-fab" aria-label="Înapoi la pagina principală">🏠 Acasă</a>

<%- include('../partials/footer') %>
