<%- include('../partials/header', { title }) %>

<div class="page-container">
  <div class="page-head">
    <h1>Categorii</h1>
    <p class="sub">Ce vrei să cumperi astăzi?</p>
  </div>

  <div class="cat-toolbar">
    <span class="cat-toolbar-label">Organizare:</span>
    <div class="cat-sort-toggle" id="catSortToggle" role="group" aria-label="Organizare categorii">
      <button type="button" class="cat-sort-btn" data-sort="alpha">Alfabetic</button>
      <button type="button" class="cat-sort-btn" data-sort="pin">Fixate sus</button>
    </div>
    <button type="button" class="cat-pin-hint" id="catPinHint"><svg class="cat-pin-svg" viewBox="0 0 24 24" width="18" height="18" fill="#2e7d32" stroke="#2e7d32" stroke-width="1.5"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5" fill="#fff"/></svg> Apasă pe o categorie ca să o fixezi sus</button>
  </div>

  <div class="cat-grid" id="catGrid">
    <% categories.forEach(c => { %>
      <div class="cat-grid-card" data-cat="<%= c.name %>" style="--cat-color:<%= c.color %>">
        <a href="/?category=<%= encodeURIComponent(c.name) %>" class="cat-grid-link">
          <div class="cat-grid-img">
            <img src="<%= c.image %>" alt="<%= c.name %>" loading="lazy" onerror="this.outerHTML='<span class=&quot;cat-icon-big&quot;><%= c.icon %></span>'">
          </div>
          <div class="cat-grid-info">
            <strong><%= c.icon %> <%= c.name %></strong>
            <small><%= c.count %> produse</small>
          </div>
        </a>
        <button type="button" class="cat-pin-btn" data-pin="<%= c.name %>" aria-label="Fixează <%= c.name %> sus" title="Fixează sus"><svg class="cat-pin-svg" viewBox="0 0 24 24" width="20" height="20" fill="#2e7d32" stroke="#2e7d32" stroke-width="1.5"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5" fill="#fff"/></svg></button>
        <button type="button" class="fav-btn cat-fav-btn" data-fav="<%= c.name %>" data-fav-type="categories" aria-label="Adaugă la favorite" title="Favorite"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
      </div>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>
