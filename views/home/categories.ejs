<%- include('../partials/header', { title }) %>

<div class="page-container">
  <div class="page-head">
    <h1>Categorii</h1>
    <p class="sub">Ce vrei să cumperi astăzi?</p>
  </div>

  <div class="cat-grid">
    <% categories.forEach(c => { %>
      <a href="/?category=<%= encodeURIComponent(c.name) %>" class="cat-grid-card" style="--cat-color:<%= c.color %>">
        <div class="cat-grid-img">
          <img src="<%= c.image %>" alt="<%= c.name %>" loading="lazy" onerror="this.outerHTML='<span class=&quot;cat-icon-big&quot;><%= c.icon %></span>'">
        </div>
        <div class="cat-grid-info">
          <strong><%= c.icon %> <%= c.name %></strong>
          <small><%= c.count %> produse</small>
        </div>
      </a>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>
