<div class="cultivator-card">
  <a href="/producator/<%= c.id %>" class="cultivator-link" data-open-card>
    <div class="cultivator-cover">
      <% if (c.cover_url) { %>
        <img src="<%= c.cover_url %>" alt="Grădina <%= c.name %>" loading="lazy">
      <% } else { %>
        <div class="cultivator-cover-fallback"><span>🌾</span></div>
      <% } %>
    </div>
  </a>

  <div class="cultivator-top">
    <% if (c.whatsapp) { %>
      <a href="https://wa.me/<%= c.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="cult-ico wa" title="WhatsApp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
    <% } %>
    <% if (c.phone) { %>
      <a href="tel:<%= c.phone %>" class="cult-ico phone" title="Sună">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
    <% } %>
  </div>

  <% if (c.announcement) { %>
    <%
      const annCount = (c.announcements && c.announcements.length) || 1;
      const annText = [c.announcement.title, c.announcement.percent ? '-' + c.announcement.percent + '%' : '', c.announcement.message].filter(Boolean).join(' · ');
    %>
    <div class="cultivator-ann" data-open-card="announcements"><b class="cultivator-ann-count"><%= annCount %></b><span class="cultivator-ann-text"><%= annText %></span></div>
  <% } %>

  <div class="cultivator-overlay">
    <div class="cultivator-avatar">
      <% if (c.avatar_url) { %>
        <img src="<%= c.avatar_url %>" alt="Avatar <%= c.name %>" loading="lazy">
      <% } else { %>
        <span>👨‍🌾</span>
      <% } %>
    </div>
    <div class="cultivator-body">
      <a href="/producator/<%= c.id %>" class="cultivator-name" data-open-card="reviews"><%= c.name %></a>
      <small class="cultivator-loc">📍 <%= c.county %><%= c.locality ? ' · ' + c.locality : '' %><% if (c.distanceLabel) { %> · <b class="cult-dist"><%= c.distanceLabel %></b><% } %></small>
      <div class="cultivator-rating" data-open-card="reviews">
        <span class="stars">
          <% for (let i = 1; i <= 5; i++) { %>
            <svg class="<%= i <= Math.round(c.rating) ? 'star-on' : 'star-off' %>" viewBox="0 0 24 24" width="14" height="14"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <% } %>
        </span>
        <span class="rating-num"><%= c.rating %> (<%= c.ratingCount %>)</span>
      </div>
    </div>
  </div>

  <% if ((c.announcements && c.announcements.length) || (c.products && c.products.length) || (c.reviews && c.reviews.length)) { %>
    <button type="button" class="cultivator-reviews-toggle" aria-expanded="false">
      Produse &amp; Recenzii ▾
    </button>
    <div class="cultivator-reviews" aria-hidden="true">
      <div class="cult-reviews-head">
        <strong><%= c.name %></strong>
        <button type="button" class="cult-reviews-close" aria-label="Închide">✕</button>
      </div>

      <div class="cult-reviews-hero">
        <% if (c.cover_url) { %>
          <div class="cult-hero-cover"><img src="<%= c.cover_url %>" alt="Grădina <%= c.name %>"></div>
        <% } else { %>
          <div class="cult-hero-cover fallback"><span>🌾</span></div>
        <% } %>
        <div class="cult-hero-body">
          <div class="cult-hero-avatar">
            <% if (c.avatar_url) { %>
              <img src="<%= c.avatar_url %>" alt="Avatar <%= c.name %>">
            <% } else { %>
              <span>👨‍🌾</span>
            <% } %>
          </div>
          <div class="cult-hero-info">
            <strong><%= c.name %></strong>
            <small>📍 <%= c.county %><%= c.locality ? ' · ' + c.locality : '' %></small>
          </div>
        </div>
      </div>

      <% if (c.announcements && c.announcements.length) { %>
        <div class="cult-announcements">
          <% c.announcements.forEach(ann => { %>
            <div class="cult-announcement ann-<%= ann.type %>">
              <strong><%= ann.title %><% if (ann.percent) { %> · -<%= ann.percent %>%<% } %></strong>
              <% if (ann.message) { %><p><%= ann.message %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (c.products && c.products.length) { %>
        <div class="cult-products">
          <% c.products.forEach(pr => { %>
            <div class="cult-product">
              <% if (pr.image_url) { %>
                <img src="<%= pr.image_url %>" alt="<%= pr.name %>" loading="lazy">
              <% } %>
              <div class="cult-product-info">
                <strong><%= pr.name %></strong>
                <span class="cult-product-price"><%= pr.price.toFixed(2).replace('.', ',') %> lei / <%= pr.unit %></span>
              </div>
              <button type="button" class="add-btn" data-add="<%= pr.id %>" aria-label="Adaugă <%= pr.name %> în coș">+</button>
            </div>
          <% }) %>
          <a href="/producator/<%= c.id %>" class="cult-product-more">Vezi toate produsele →</a>
        </div>
      <% } %>

      <% if (c.reviews && c.reviews.length) { %>
        <div class="cult-reviews-list">
          <% c.reviews.forEach(rv => { %>
            <div class="cult-review">
              <div class="cult-review-head">
                <strong><%= rv.user_name %></strong>
                <span class="stars">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <svg class="<%= i <= rv.rating ? 'star-on' : 'star-off' %>" viewBox="0 0 24 24" width="11" height="11"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  <% } %>
                </span>
              </div>
              <p><%= rv.comment %></p>
              <% if (rv.reply) { %>
                <div class="cult-reply">🧑‍🌾 <strong><%= c.name %>:</strong> <%= rv.reply %></div>
              <% } %>
              <% if (isProducer && c.user_id === producerUserId) { %>
                <details class="cult-reply-form">
                  <summary>Răspunde</summary>
                  <form method="POST" action="/review/<%= rv.id %>/raspunde">
                    <textarea name="reply" rows="2" placeholder="Scrie un răspuns…" required></textarea>
                    <button type="submit" class="btn btn-primary btn-sm">Trimite răspunsul</button>
                  </form>
                </details>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
