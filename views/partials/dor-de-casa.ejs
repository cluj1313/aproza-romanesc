<section class="ddc-card">
  <div class="ddc-info">
    <div class="ddc-title">
      <span class="ddc-icon">
        <svg viewBox="0 0 32 32" width="28" height="28">
          <defs>
            <linearGradient id="houseGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#4caf50"/>
              <stop offset="100%" stop-color="#2e7d32"/>
            </linearGradient>
          </defs>
          <rect x="8" y="14" width="16" height="14" rx="1.5" fill="url(#houseGrad)"/>
          <polygon points="4,15 16,5 28,15" fill="#ff8f00"/>
          <rect x="13" y="20" width="6" height="8" rx="1" fill="#fff9c4"/>
          <rect x="9" y="16" width="4" height="3.5" rx="0.5" fill="#e3f2fd" stroke="#fff" stroke-width="0.5"/>
          <rect x="19" y="16" width="4" height="3.5" rx="0.5" fill="#e3f2fd" stroke="#fff" stroke-width="0.5"/>
          <rect x="22" y="7" width="3" height="7" rx="0.5" fill="#ff8f00"/>
          <polygon points="22,7 23.5,3 25,7" fill="#e65100"/>
        </svg>
      </span>
      <div>
        <strong>Dor de Casă</strong>
        <small>Lanț de magazine · produse 100% românești</small>
      </div>
    </div>
    <p class="ddc-text">
      <span class="ddc-points">300+ magazine</span> în toată România. Găsește magazinul cel mai apropiat de tine.
    </p>
    <div class="ddc-actions">
      <button type="button" class="btn btn-cta btn-sm" id="nearestStoreBtn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Magazinul cel mai apropiat
      </button>
    </div>
  </div>
  <a href="/magazine" class="ddc-all-stores">Toate magazinele →</a>
  <div id="nearestStoreResult" class="ddc-result hidden">
    <p>📍 <strong id="nsName"></strong></p>
    <p id="nsAddr"></p>
    <span id="nsDist" class="chip chip-light"></span>
  </div>
</section>
