<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Aprozar Românesc</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/jpeg" href="/images/logo.jpeg">
</head>
<body>
  <div class="app-shell">

    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <span class="brand-logo">
            <img src="/images/logo.jpeg" alt="Aprozar Românesc" width="40" height="40">
          </span>
          <span class="brand-text">
            <strong>Aprozar Românesc</strong>
            <small>100% românesc · direct de la țară</small>
          </span>
        </a>
      </div>

      <nav class="topnav" aria-label="Meniu principal">
        <div class="topnav-inner">
          <a href="/" class="<%= title === 'Acasă' ? 'active' : '' %>" title="Acasă"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></a>
          <a href="/categorii" class="<%= title === 'Categorii' ? 'active' : '' %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg> Categ</a>
          <a href="/favorit" class="<%= title === 'Favoriți' ? 'active' : '' %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> Favorit</a>
          <a href="/cumparaturi" class="<%= title === 'Cumpărături' ? 'active' : '' %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Coș</a>
          <a href="/contul-meu" class="<%= title === 'Contul meu' ? 'active' : '' %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Cont</a>
        </div>
      </nav>

      <div class="settings-bar">
        <div class="cs-wrap">
          <button type="button" class="icon-btn" id="csToggle" aria-label="Schimbă culorile de fundal" aria-expanded="false" title="Culori de fundal">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
              <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>
            </svg>
          </button>
          <div class="cs-popover hidden" id="csPopover" role="dialog" aria-label="Culori de fundal">
            <div class="cs-title">Culoare de fundal</div>
            <div class="cs-grid">
              <button type="button" class="cs-swatch cs-green" data-cs="green" aria-label="Verde" title="Verde"></button>
              <button type="button" class="cs-swatch cs-gl" data-cs="gl" aria-label="Gri deschis" title="Gri deschis"></button>
              <button type="button" class="cs-swatch cs-gm" data-cs="gm" aria-label="Gri mediu" title="Gri mediu"></button>
              <button type="button" class="cs-swatch cs-g" data-cs="g" aria-label="Gri" title="Gri"></button>
              <button type="button" class="cs-swatch cs-gi" data-cs="gi" aria-label="Gri inchis" title="Gri inchis"></button>
              <button type="button" class="cs-swatch cs-gi2" data-cs="gi2" aria-label="Gri foarte inchis" title="Gri foarte inchis"></button>
            </div>
          </div>
        </div>
        <div class="fs-ctl" role="group" aria-label="Mărimea textului">
          <button type="button" class="fs-btn" data-fs="0.9" aria-label="Text mic" title="Text mic">A</button>
          <button type="button" class="fs-btn" data-fs="1" aria-label="Text normal" title="Text normal">A</button>
          <button type="button" class="fs-btn" data-fs="1.15" aria-label="Text mare" title="Text mare">A</button>
          <button type="button" class="fs-btn" data-fs="1.3" aria-label="Text foarte mare" title="Text foarte mare">A</button>
        </div>
        <a href="/favorit" class="icon-btn" aria-label="Favoriți" title="Favoriți">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="#e53e3e" stroke="#e53e3e" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </a>
        <button type="button" class="icon-btn" id="themeToggle" aria-label="Fundal verde închis" aria-pressed="false" title="Fundal verde închis">
          <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="icon-sun hidden" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
        <button type="button" class="icon-btn" id="shareBtn" aria-label="Distribuie aplicația" title="Distribuie aplicația">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
        </button>
        <a href="/notificari" class="icon-btn" aria-label="Notificări" title="Notificări">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <% if (unreadNotifs > 0) { %><span class="badge-dot"><%= unreadNotifs %></span><% } %>
        </a>
        <a href="/cumparaturi" class="icon-btn" aria-label="Coș de cumpărături" title="Coș de cumpărături">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <% if (cartCount > 0) { %><span class="badge-dot badge-cart"><%= cartCount %></span><% } %>
        </a>
      </div>
    </header>
