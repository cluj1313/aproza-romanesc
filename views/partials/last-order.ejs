<section class="home-section last-order-section">
  <% if (!lastOrder) { %>
    <div class="last-order-card last-order-empty">
      <% if (user) { %>
        <div class="last-order-title">
          <h2 class="last-order-title-h">🕘 Ultimele Cumpărături</h2>
          <p>Nu ai făcut încă nicio comandă.</p>
          <small>Plasează prima comandă și o vei găsi aici pentru re-cumpărare rapidă.</small>
        </div>
      <% } else { %>
        <div class="last-order-head">
          <div class="last-order-text">
            <h2 class="last-order-title-h">🕘 Ultimele Cumpărături</h2>
            <span class="last-order-subtitle">Comandă rapid ca și ultima dată.</span>
          </div>
          <button type="button" class="last-order-reorder-icon" data-quick-login aria-label="Recumpără rapid">
            <svg viewBox="0 0 40 40" width="40" height="40">
              <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 8h3l2.5 12h14l2.5-8H13"/>
                <circle cx="16" cy="28" r="2.5" fill="currentColor"/>
                <circle cx="26" cy="28" r="2.5" fill="currentColor"/>
              </g>
              <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M30 18a4 4 0 1 1-1.5 3"/>
                <polyline points="28.5 15.5 30 18 27.5 19"/>
              </g>
            </svg>
          </button>
        </div>
      <% } %>
    </div>
  <% } else { %>

    <div class="last-order-card">
      <div class="last-order-head">
        <h2 class="last-order-title-h">🕘 Ultimele Cumpărături</h2>
        <button type="button" class="last-order-cta" data-reorder>⚡ Comandă rapid ca și ultima dată</button>
      </div>

      <% lastOrder.producers.forEach(pr => { %>
        <% const prItems = lastOrder.items.filter(i => i.producer_id === pr.id) %>
        <div class="last-order-producer-row">
          <a href="/producator/<%= pr.id %>" class="last-order-producer">
            <span class="last-order-avatar">
              <% if (pr.avatar_url) { %><img src="<%= pr.avatar_url %>" alt=""><% } else { %>🏡<% } %>
            </span>
            <strong><%= pr.name %></strong>
            <small><%= pr.county %></small>
          </a>
          <div class="last-order-items">
            <% prItems.forEach(it => { %>
              <div class="last-order-item">
                <div class="last-order-thumb">
                  <% if (it.image_url) { %><img src="<%= it.image_url %>" alt=""><% } else { %>🥬<% } %>
                </div>
                <div class="last-order-info">
                  <strong><%= it.product_name %></strong>
                  <small><%= it.qty %> × <%= it.price.toFixed(2).replace('.', ',') %> lei</small>
                </div>
                <button type="button" class="btn btn-primary btn-sm" data-add="<%= it.product_id %>">+</button>
              </div>
            <% }) %>
          </div>
          <a href="/producator/<%= pr.id %>" class="btn btn-ghost btn-sm">Vezi produsele</a>
        </div>
      <% }) %>
    </div>

  <% } %>
</section>
