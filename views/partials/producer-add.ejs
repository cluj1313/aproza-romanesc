<section class="home-section producer-add-section">
  <div class="producer-add-card">
    <div class="producer-add-head">
      <h2 class="producer-add-title">👨‍🌾 Ești producător?</h2>
      <span class="producer-add-sub">Vinde produsele tale proaspete direct către clienți.</span>
    </div>

    <% if (isProducer) { %>
      <button type="button" class="producer-add-pill" id="producerAddToggle" aria-expanded="false">
        <span class="producer-add-pill-icon">➕</span>
        <span class="producer-add-pill-text">Adaugă produs</span>
        <span class="producer-add-pill-chev" id="producerAddChev">▾</span>
      </button>

      <div class="producer-add-form hidden" id="producerAddForm">
        <div class="producer-add-fields">
          <label class="pa-field">
            <span>Categorie</span>
            <select name="paCategory" id="paCategory">
              <option value="">Alege categoria…</option>
              <% categories.forEach(c => { %>
                <option value="<%= c.name %>"><%= c.icon %> <%= c.name %></option>
              <% }) %>
            </select>
          </label>
          <label class="pa-field">
            <span>Produs</span>
            <select name="paProduct" id="paProduct" disabled>
              <option value="">Mai întâi alege categoria</option>
            </select>
          </label>
          <label class="pa-field pa-field-custom hidden" id="paCustomWrap">
            <span>Numele produsului</span>
            <input type="text" name="paCustomName" id="paCustomName" placeholder="ex. Roșii cherry">
          </label>
          <div class="pa-row">
            <label class="pa-field">
              <span>Preț (lei)</span>
              <input type="number" step="0.01" min="0" name="paPrice" id="paPrice" placeholder="ex. 8.50">
            </label>
            <label class="pa-field">
              <span>Cantitate / unitate</span>
              <select name="paUnit" id="paUnit">
                <% ['kg', 'g', 'L', 'ml', 'buc', 'legătură', 'căpățână', 'borcan', 'pachet', 'pungă', 'cui', 'zece', 'litru'].forEach(u => { %>
                  <option value="<%= u %>"><%= u %></option>
                <% }) %>
              </select>
            </label>
          </div>
        </div>
        <div class="pa-actions">
          <button type="button" class="btn btn-primary btn-sm" id="paSubmit">Publică produsul</button>
          <span class="pa-status" id="paStatus"></span>
        </div>
      </div>
    <% } else { %>
      <a href="/login?next=/produs/nou" class="producer-add-pill">
        <span class="producer-add-pill-icon">➕</span>
        <span class="producer-add-pill-text">Adaugă produs</span>
        <span class="producer-add-pill-chev">→</span>
      </a>
    <% } %>
  </div>
</section>
