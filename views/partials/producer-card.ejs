<a href="/producator/<%= p.id %>" class="producer-card" data-producer>
  <div class="pc-cover">
    <% if (p.cover_url) { %>
      <img src="<%= p.cover_url %>" alt="Ferma <%= p.name %>" loading="lazy">
    <% } else { %>
      <div class="pc-cover-fallback"><span>🌾</span></div>
    <% } %>

    <div class="pc-contact">
      <% if (p.whatsapp) { %>
        <a href="https://wa.me/<%= p.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="contact-btn wa" title="Scrie pe WhatsApp" onclick="event.stopPropagation()">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
      <% } %>
      <% if (p.phone) { %>
        <a href="tel:<%= p.phone %>" class="contact-btn phone" title="Sună" onclick="event.stopPropagation()">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      <% } %>
    </div>

    <div class="pc-avatar">
      <% if (p.avatar_url) { %>
        <img src="<%= p.avatar_url %>" alt="Avatar <%= p.owner_name || p.name %>" loading="lazy">
      <% } else { %>
        <span>👨‍🌾</span>
      <% } %>
    </div>
  </div>

  <div class="pc-body">
    <div class="pc-head">
      <div class="pc-titles">
        <h3><%= p.name %></h3>
        <% if (p.owner_name) { %><p class="pc-owner">👨‍🌾 <%= p.owner_name %></p><% } %>
        <p class="pc-loc">📍 <%= p.county %><%= p.locality ? ' · ' + p.locality : '' %></p>
      </div>
      <div class="pc-meta">
        <% if (p.distanceLabel) { %>
          <span class="chip chip-distance">🚗 la <%= p.distanceLabel %></span>
        <% } %>
        <span class="rating-badge" title="Rating">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#f9a825"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <strong><%= p.rating %></strong>
          <small>(<%= p.ratingCount %>)</small>
        </span>
      </div>
    </div>

    <% if (p.announcement) { %>
      <div class="announcement-tag ann-<%= p.announcement.type %>">
        <span><%= p.announcement.title %></span>
        <% if (p.announcement.percent) { %><em>-<%= p.announcement.percent %>%</em><% } %>
      </div>
    <% } %>

    <% if (p.products && p.products.length) { %>
      <div class="pc-mini-products">
        <% p.products.slice(0, 3).forEach(pr => { %>
          <div class="mini-product" onclick="event.stopPropagation()">
            <% if (pr.image_url) { %>
              <img src="<%= pr.image_url %>" alt="<%= pr.name %>" loading="lazy">
            <% } %>
            <div class="mini-info">
              <strong><%= pr.name %></strong>
              <span class="mini-price"><%= pr.price.toFixed(2).replace('.', ',') %> lei / <%= pr.unit %></span>
            </div>
            <button type="button" class="add-btn" data-add="<%= pr.id %>" aria-label="Adaugă <%= pr.name %> în coș">+</button>
          </div>
        <% }) %>
      </div>
    <% } %>

    <p class="pc-desc"><%= p.description ? p.description.slice(0, 90) + (p.description.length > 90 ? '…' : '') : 'Producător local autentic.' %></p>
  </div>
</a>
