<div class="product-card">
  <div class="pcard-img">
    <% if (pr.image_url) { %>
      <img src="<%= pr.image_url %>" alt="<%= pr.name %>" loading="lazy">
    <% } else { %>
      <div class="pcard-fallback">🥬</div>
    <% } %>
    <% if (pr.name && pr.name.indexOf('[TEST]') !== -1) { %><span class="mock-badge">TEST</span><% } %>
    <button type="button" class="fav-btn pcard-fav-btn" data-fav="<%= pr.id %>" data-fav-type="products" aria-label="Adaugă la favorite" title="Favorite"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
  </div>
  <div class="pcard-body">
    <h4><%= pr.name %></h4>
    <a href="/producator/<%= pr.producer_id %>" class="pcard-provenance">De la <%= pr.producer_name %><%= pr.county ? ' · ' + pr.county : '' %></a>
    <div class="pcard-footer">
      <span class="price"><%= pr.price.toFixed(2).replace('.', ',') %> lei</span>
      <span class="unit">/ <%= pr.unit %></span>
      <button type="button" class="add-btn add-btn-round" data-add="<%= pr.id %>" aria-label="Adaugă în coș">+</button>
    </div>
  </div>
</div>
